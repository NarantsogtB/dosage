{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dosage",
  "pages_build_output_dir": "out",
  // Заавал: байхгүй бол Function-ийн deploy "No such module node:stream"-ээр унана.
  // Локал wrangler-ийн workerd дэмждэгээс шинэ огноо БҮҮ тавь — `bun run preview` унана.
  "compatibility_date": "2026-08-22",
  // functions/api/e.ts → үйлдлийн analytics. docs/ANALYTICS.md
  "analytics_engine_datasets": [
    { "binding": "EVENTS", "dataset": "dosage_events" }
  ]
}
