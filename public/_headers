# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Service worker ХЭЗЭЭ Ч кэшлэгдэхгүй — эс бөгөөс шинэ deploy хэрэглэгчид хүрэхгүй
# (Next PWA гарын авлага). Кэшийн хувилбарыг sw.js дотор BUILD_ID удирдана.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/javascript; charset=utf-8
