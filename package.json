{
  "name": "dosage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "rm -rf .next && next dev --port 3002",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u",
    "typecheck": "next typegen && tsc --noEmit",
    "contrast": "node scripts/contrast.mjs",
    "check": "bun run lint && bun run typecheck && bun run contrast && bun run test && bun run build",
    "preview": "next build && wrangler pages dev out",
    "deploy": "next build && wrangler pages deploy"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.544.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wrangler": "^4.124.0"
  },
  "packageManager": "bun@1.2.20",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
