{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "dosage-doc.vercel.app"
        }
      ],
      "destination": "https://dosage.mn/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "dosage-doc.vercel.app"
        }
      ],
      "destination": "https://dosage.mn/:path*",
      "permanent": true
    }
  ]
}
