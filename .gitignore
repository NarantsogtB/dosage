# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# FUSE-ийн үлдэгдэл — нээлттэй байхад устгасан файлын сүүдэр.
# Кодын агуулгатай харагдавч түүх БИШ, санамсаргүй хуулбар.
.fuse_hidden*

# Түр зуурын ажлын хавтас. Устгахад бэлэн зүйлс энд хэвтэнэ —
# репод оруулахгүй, гэхдээ өөрөө устгах хүртэл байрандаа үлдэнэ.
/_to_delete/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

!.env.example

# graphify — үүсгэсэн граф, дахин үнэгүй генерацлаж болно (`graphify update .`)
/graphify-out/

# Obsidian vault-local тохиргоо (хувийн, төхөөрөмж бүрт өөр)
/.obsidian/
